{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photo-texte",
  "account_id": "2ea670c2a6ff28e248ef084adf095e8b",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "phototexte.noema-learn.uk",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "photo-texte"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "photo-texte",
      "database_id": "393aec73-1ce5-40d0-a827-f18caa9a22f5",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT_BUCKET",
      "bucket_name": "photo-texte-content"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://phototexte.noema-learn.uk",
    "OPENAI_MODEL": "gpt-4o-mini",
    "PHOTO_BUCKET": "photos",
    "EXPORT_BUCKET": "exports"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "photo-texte-dev",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "photo-texte-dev"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "photo-texte",
          "database_id": "393aec73-1ce5-40d0-a827-f18caa9a22f5",
          "migrations_dir": "cloudflare/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "CONTENT_BUCKET",
          "bucket_name": "photo-texte-content"
        }
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://photo-texte-dev.mani1261790.workers.dev",
        "OPENAI_MODEL": "gpt-4o-mini",
        "PHOTO_BUCKET": "photos",
        "EXPORT_BUCKET": "exports"
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
