    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0",
    "vite": "7.3.7"
  },
  "overrides": {
    "baseline-browser-mapping@2.9.19": "2.11.0",
