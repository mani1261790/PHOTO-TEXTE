    "jszip": "^3.10.1",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^3.12.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
