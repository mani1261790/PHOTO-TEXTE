{
  "name": "photo-texte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build --env \"\"",
    "cf:build:dev": "opennextjs-cloudflare build --env dev",
    "cf:preview": "opennextjs-cloudflare build --env \"\" && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build --env \"\" && opennextjs-cloudflare deploy --env \"\"",
    "cf:deploy:dev": "opennextjs-cloudflare build --env dev && opennextjs-cloudflare deploy --env dev",
    "cf:types": "wrangler types --strict-vars false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env \"\"",
    "db:migrate:shared": "wrangler d1 migrations apply DB --remote --env \"\"",
    "data:migrate:cloudflare": "node scripts/migrate-supabase-to-cloudflare.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "better-auth": "^1.6.26",
    "diff": "8.0.3",
    "jszip": "^3.10.1",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^3.12.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@expo-google-fonts/noto-sans-jp": "^0.4.3",
    "@noble/ciphers": "^1.3.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "sharp": "^0.35.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.119.0"
  }
}
